# ═══════════════════════════════════════════════════════════════
# SITTI — Panel de Gestión · variables de entorno
#
# Copia este archivo a `.env` y llena lo que necesites.
# ⚠️ `.env` está en .gitignore. NUNCA lo commitees ni lo pegues en un chat.
# ═══════════════════════════════════════════════════════════════

# ── MODO DEMO ──────────────────────────────────────────────────
# true  = datos generados localmente. No necesita base ni Jira. (por defecto)
# false = lee de Postgres. Requiere DATABASE_URL y que el ETL ya haya corrido.
DEMO_MODE=true

# ── SESIÓN ─────────────────────────────────────────────────────
# Obligatoria con DEMO_MODE=false. Mínimo 32 caracteres.
# Genérala así:  openssl rand -base64 32
# Si cambia, todas las sesiones abiertas se invalidan (eso está bien).
AUTH_SECRET=

# ── BASE DE DATOS (Neon, plan gratuito) ────────────────────────
# console.neon.tech → tu proyecto → Connection string
DATABASE_URL=

# ── JIRA / JSM (solo lo usa el ETL, no la app web) ─────────────
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
# ⚠️ La cuenta debe tener permisos de SOLO LECTURA.
JIRA_BASE_URL=https://sitti.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── MAPA ───────────────────────────────────────────────────────
# Opcional. Sin esto el mapa usa teselas de OpenStreetMap (gratis, sin cuenta).
# Con llave de MapTiler (gratis, 100k teselas/mes) usa un estilo vectorial
# más limpio y con variante oscura de verdad: cloud.maptiler.com
# ⚠️ Viaja al navegador (NEXT_PUBLIC_). RESTRINGE la llave por dominio.
NEXT_PUBLIC_MAPTILER_KEY=

# ── SINCRONIZACIÓN ─────────────────────────────────────────────
# El sync 2x/día corre en GitHub Actions (.github/workflows/sync-jira.yml),
# no en Vercel: el ETL tarda minutos y una función serverless se corta a los
# 60 segundos en el plan gratuito. Las credenciales de Jira y DATABASE_URL van
# en los secrets del repositorio de GitHub.
